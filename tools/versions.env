# Single source of truth for pinned toolchain versions. Sourced by tools/setup.sh,
# read by tools/build_firmware.py and the CI workflow. Change deliberately; re-baseline after.
ARDUINO_CLI_VERSION=1.5.1
ARDUINO_CLI_SHA256_MACOS_ARM64=cb952e8c1621c95ef5f1d17831c945e3d0ec5973f89c557a7ec8feb9c4f7d4c9
ARDUINO_CLI_SHA256_LINUX_X86_64=28a8e119c498a25607821c36cb2dc49e8463941b261a0d99091baa7bc692dd2b
AVR_CORE=arduino:avr
AVR_CORE_VERSION=1.8.6
# avr-gcc is installed as a dependency of the core; this is the version we expect to find.
AVR_GCC_VERSION=7.3.0-atmel3.6.1-arduino7
FQBN=arduino:avr:diecimila:cpu=atmega328
# LedControl is vendored as a git submodule at third_party/LedControl (tag 1.0.6).
LEDCONTROL_VERSION=1.0.6
# simavr is vendored as a git submodule at third_party/simavr (v1.8-8-gfe665ce).
SIMAVR_SHA=fe665cef7d309e95bafe7339cdf11fe73d9218b3
